# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o Git.
GA4_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS=credenciais/ga4-service-account.json

# ETAPA 05 (Search Console): exatamente como aparece no Search Console
#   Propriedade de domínio:  sc-domain:exemplo.com.br
#   Prefixo de URL:          https://www.exemplo.com.br/   (com a barra final)
GSC_SITE_URL=sc-domain:exemplo.com.br

# ETAPA 07 (PostgreSQL). Use um usuário próprio do projeto, NUNCA o superusuário 'postgres'.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics
DB_USER=analytics_app
DB_PASSWORD=troque_esta_senha
# Banco na nuvem? Use a URL completa que o serviço fornece (ela tem prioridade sobre as 5 linhas acima):
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# ETAPA 10 (IA): chave da API da Anthropic (platform.claude.com). NUNCA compartilhe nem versione esta chave.
ANTHROPIC_API_KEY=cole_sua_chave_aqui
# (opcional) modelo usado pelo agente. Padrão: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Enviar consultas de busca e URLs do site para a IA? true ou false
AGENT_SEND_QUERIES=true

# ETAPA 11 (API). Gere a chave com:  python 11-api-aplicacao\main.py --gerar-chave
# (esta é a chave dos CLIENTES DA SUA API; não é a da Anthropic. Mínimo 24 caracteres.)
API_KEY=
# Por padrão a API só é acessível neste computador (127.0.0.1). Não mude sem entender o risco.
# API_HOST=127.0.0.1
# API_PORT=8000
# Liga o endpoint de IA (/v1/perguntar): usa a API da Anthropic e gera custo. Padrão: false
API_ENABLE_AGENT=false
# API_AGENT_MAX_PER_HOUR=20
