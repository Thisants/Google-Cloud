# --- Segredos (NUNCA versionar) ---
.env
.env.*
!.env.example
credenciais/*
!credenciais/.gitkeep
*service-account*.json
*credentials*.json
client_secret*.json
token.json
*.pem
*.key

# --- Dados reais do negócio ---
**/dados/*
!**/dados/.gitkeep
data/
*.csv
*.xlsx
*.db
*.sqlite

# --- Backups do banco (contêm dados reais do negócio) ---
backups/
*.dump

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/

# --- Editor / sistema ---
.vscode/
.idea/
.DS_Store
Thumbs.db
