# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o Git.
GA4_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS=credenciais/ga4-service-account.json

# ETAPA 05 (Search Console): exatamente como aparece no Search Console
#   Propriedade de domínio:  sc-domain:exemplo.com.br
#   Prefixo de URL:          https://www.exemplo.com.br/   (com a barra final)
GSC_SITE_URL=sc-domain:exemplo.com.br

# ETAPA 07 (PostgreSQL). Use um usuário próprio do projeto, NUNCA o superusuário 'postgres'.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics
DB_USER=analytics_app
DB_PASSWORD=troque_esta_senha
# Banco na nuvem? Use a URL completa que o serviço fornece (ela tem prioridade sobre as 5 linhas acima):
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
